# ── Shopify (filled by `shopify app dev` locally; set these in production) ──
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://images.example.com
SCOPES=read_products,write_products,read_files,write_files

# ── Database / queue ──
# Local dev (docker-compose.dev.yml). In production docker-compose.yml sets both.
DATABASE_URL=postgresql://vio:vio@localhost:55432/vio?schema=public
REDIS_URL=redis://localhost:56379
# Production only: used by docker-compose.yml
POSTGRES_PASSWORD=change-me
APP_DOMAIN=images.example.com

# ── Object storage: Cloudflare R2 (S3 API) ──
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=vio-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Local MinIO instead of R2:
# S3_ENDPOINT=http://localhost:59000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true
# S3_CREATE_BUCKET=true
# S3_GPU_ENDPOINT=http://minio:9000   # when the GPU service runs in docker-compose.dev.yml
# S3_BROWSER_PROXY=true                # previews load through the app inside the Shopify admin

# ── GPU service (Modal / RunPod / docker-compose.dev.yml) ──
GPU_SERVICE_URL=https://your-workspace--vio-gpu-service-web.modal.run
GPU_SERVICE_SECRET=generate-a-long-random-string
GPU_TIMEOUT_MS=180000
# Image service backends, read by docker-compose (README "Image models and processing cost"):
# production runs the CPU models first and pays for Replicate only when a result isn't
# confidently good (the quality gate: docs/gpu-service-contract.md "Routing and the quality gate").
# GPU_MODEL_BACKEND=local
# GPU_ESCALATION_BACKEND=replicate
# GPU_FALLBACK_BACKEND=none
# GPU_ESCALATION_DAILY_MAX_CALLS=0
# Rollout of local-first processing: kill switch, share of photos tried locally first, and
# shadow mode (judge local, always use Replicate's result).
# GPU_LOCAL_PROCESSING_ENABLED=true
# GPU_LOCAL_PROCESSING_PERCENTAGE=100
# GPU_LOCAL_PROCESSING_SHADOW=false
# REPLICATE_API_TOKEN=

# ── Processing cost dashboard (README "Image models and processing cost") ──
# Bearer token for GET /internal/metrics (JSON summary; at least 16 characters). Unset = 404.
# METRICS_TOKEN=
# Average paid cut-out cost (USD) for "estimated spend avoided" when none was observed.
# REPLICATE_AVG_CUTOUT_USD=0.0009

# ── Tuning (README "Bulk jobs") ──
# Image tasks one worker process runs at once. IMAGE_WORKER_CONCURRENCY is an alias that wins
# when set. Throughput is set by the image service's MAX_CONCURRENCY and SHOP_CONCURRENCY, not
# by this: extra slots only wait on the service.
WORKER_CONCURRENCY=8
# IMAGE_WORKER_CONCURRENCY=
# Images one shop can have in flight, so one big catalog can't starve other shops.
SHOP_CONCURRENCY=3
# Tries per image (timeouts and out-of-memory: at most 2), with backoff doubling from
# ITEM_RETRY_BASE_MS (30 s, 1 min, 2 min, 4 min). The app and the worker both enqueue image
# tasks, so give both the same values.
ITEM_TASK_ATTEMPTS=5
ITEM_RETRY_BASE_MS=30000
BULK_READ_THRESHOLD=250
MAX_ITEMS_PER_JOB=5000
REVIEW_EXPIRY_DAYS=14

# ── Notifications ──
# Completion emails. No provider is implemented yet, so nothing is sent whatever this says and
# the Settings toggle stays hidden. Update the privacy policy before adding one.
# EMAIL_PROVIDER=

# ── Billing ──
FREE_CREDITS=25
# Test charges are free but still add credits. Keep false in production.
# Development stores (and App Store review) always get test charges automatically.
BILLING_TEST=false

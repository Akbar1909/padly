# Rendered by the nginx image's envsubst step (${APP_DOMAIN} comes from docker-compose).
# TLS: issue the first certificate before starting nginx (see README, "TLS").

# Log the path without the query string: embedded requests carry the
# merchant's session token (id_token) in it.
log_format vio '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
               '$status $body_bytes_sent $request_time "$http_user_agent"';

server {
    listen 80;
    server_name ${APP_DOMAIN};
    access_log /var/log/nginx/access.log vio;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};
    access_log /var/log/nginx/access.log vio;

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    # Don't add X-Frame-Options: the app is embedded in the Shopify admin. The
    # app sets the right Content-Security-Policy frame-ancestors per shop.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;

    client_max_body_size 5m;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Resolve the app container through Docker's DNS on every request, so a
    # redeploy that gives `app` a new IP doesn't leave nginx pointing at the
    # old one. /assets get their immutable Cache-Control from the app itself.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $vio_app http://app:3000;

    location / {
        proxy_pass $vio_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }
}
